{
  "name": "@xeokit/sdk",
  "private": false,
  "version": "0.1.0-alpha",
  "description": "Next generation xeokit SDK",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "scripts": {
    "sdk-test": "jest --passWithNoTests",
    "sdk-test:formats": "jest src/formats",
    "sdk-perf": "RUN_PERF=1 jest src/perf",
    "sdk-perf:update": "RUN_PERF=1 UPDATE_PERF_BASELINE=1 jest src/perf",
    "sdk-dist": "rm -Rf tsconfig.tsbuildinfo;  tsc; node ./scripts/build-cli-tools.js",
    "sdk-publish": "npm publish --access public",
    "website-sdk-docs": "typedoc --json ../website/docs/json/sdk.json --options typedoc.json --validation.invalidLink false && cp -Rf ./assets ../website/docs/."
  },
  "bin": {
    "xeoconvert": "./dist/xeoconvert/xeoconvert.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xeokit/sdk.git"
  },
  "author": "Lindsay Kay",
  "license": "SEE LICENSE IN LICENSE.md",
  "bugs": {
    "url": "https://github.com/xeokit/sdk/issues"
  },
  "homepage": "https://xeokit.github.io/sdk/docs/api/index.html",
  "files": [
    "src/",
    "README.md",
    "package.json"
  ],
  "keywords": [],
  "dependencies": {
    "@gltf-transform/core": "^4.1.3",
    "@gltf-transform/extensions": "^4.1.3",
    "@gltf-transform/functions": "^4.1.3",
    "@loaders.gl/core": "^4.0.4",
    "@loaders.gl/gltf": "^4.0.4",
    "@loaders.gl/images": "^3.4.1",
    "@loaders.gl/las": "^4.0.4",
    "@loaders.gl/math": "^4.0.4",
    "@loaders.gl/polyfills": "^4.0.4",
    "@loaders.gl/textures": "^4.0.4",
    "@napi-rs/canvas": "^1.0.1",
    "commander": "^11.0.0",
    "pako": "^2.0.4",
    "strongly-typed-events": "3.0.7",
    "tinyusdz": "^0.9.1",
    "web-ifc": "^0.0.50",
    "yargs": "17.7.2"
  },
  "peerDependencies": {
    "typedoc": "^0.27.6"
  },
  "devDependencies": {
    "@swc/core": "^1.15.40",
    "@swc/jest": "^0.2.39"
  }
}
