{
    "compilerOptions": {
        "composite": true,
        "rootDir": "./src",
        "outDir": "dist",
        "esModuleInterop": true,
        "moduleResolution": "node",
        "lib": [
            "es6",
            "dom",
            "es2021"
        ],
        "types": [
            "node"
        ],
        "skipLibCheck": true,
        // https://stackoverflow.com/questions/66956030/apache-arrow-does-not-compile-with-typescript
        "target": "esnext",
        "module": "esnext",
        "stripInternal": false,
        "typeRoots": [
            "../../node_modules/@types"
        ],
        "strict": false,
        "alwaysStrict": true,
        "strictFunctionTypes": true,
        "strictBindCallApply": true,
        "strictPropertyInitialization": false,
        "noImplicitThis": true,
      "noImplicitAny": false,
        "declaration": true,
        "verbatimModuleSyntax": true,
        "sourceMap": true,
        "baseUrl": ".",
        "declarationMap": true,
        "noEmit": false,
        "emitDeclarationOnly": true
    },
    "include": [
        "./src/**/*.ts"
    ],
    "exclude": [
        "dist",
        "node_modules"
    ],
    "typeRoots": [
        "node_modules/@types"
    ],
    "plugin": [
        "typedoc-plugin-mermaid"
    ]
}
