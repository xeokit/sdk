{
    "$schema": "https://typedoc.org/schema.json",
    "plugin": [
        "typedoc-plugin-mermaid"
    ],
    "includeVersion": true,
    "excludePrivate": true,
    "excludeInternal": true,
    "visibilityFilters": {
        "protected": false,
        "private": false,
        "inherited": true,
        "external": false,
        "@alpha": false,
        "@beta": false
    },
    "entryPoints": [
        "src/index.ts"
    ],
  "useTsLinkResolution": true,
  "validation": {
    "invalidLink": false,
    "notExported": false
  },
  "ignoredHighlightLanguages": [
    "mermaid",
    "glsl",
    "xml",
    "md",
    "javascript*"
  ]
}
