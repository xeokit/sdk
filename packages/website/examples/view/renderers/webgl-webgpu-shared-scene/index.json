{
  "id": "view/renderers/webgl-webgpu-shared-scene",
  "title": "WebGL + WebGPU - Shared Scene",
  "description": "Runs separate WebGL and WebGPU viewers against one shared Scene and Data graph loaded from the House Plan PBR GLB.",
  "isTutorial": false,
  "isVisualTest": true,
  "categories": [
