    "selectors": [
      "#webglViewport",
      "#webgpuViewport"
    ],
    "minUniqueBuckets": 12,
    "minNonBackgroundRatio": 0.04,
    "maskSelectors": [
      "#effectBanner",
      "#rendererLabels",
      ".hud",
      "#dataStatus"
    ],
    "comparePairs": [
      {
        "a": "#webglViewport",
        "b": "#webgpuViewport"
      }
    ]
  }
