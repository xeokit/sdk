            "__cmd": "node ../sdk/dist/ifc2gltf2xgf/ifc2gltf2xgf.js -i ./models/${modelId}/ifc2gltf/model.manifest.json -o ./models/${modelId}/ifc2gltf2xgf/model.manifest.json -l > ./models/${modelId}/ifc2gltf2xgf/log.txt",
