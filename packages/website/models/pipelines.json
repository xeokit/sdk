{
  "pipelines": [
    {
      "id": "json",
      "cmd": "node ../sdk/dist/xeoconvert/xeoconvert --pipeline json --scenemodel ./models/${modelId}/json/sceneModel.json --datamodel ./models/${modelId}/json/dataModel.json --stats-report  ./models/${modelId}/json/xeoconvert-stats-report.json --manifest-report ./models/${modelId}/json/xeoconvert-manifest-report.json --log > ./models/${modelId}/json/xeoconvert-log.txt"
    },
    {
      "id": "ifc",
      "cmd": "node ../sdk/dist/xeoconvert/xeoconvert --pipeline ifc --ifc ./models/${modelId}/ifc/model.ifc --stats-report   ./models/${modelId}/ifc/xeoconvert-stats-report.json --manifest-report ./models/${modelId}/ifc/xeoconvert-manifest-report.json  --log > ./models/${modelId}/ifc/xeoconvert-log.txt"
    },
    {
      "id": "xkt"
    },
    {
      "id": "cityjson",
      "cmd": "node ../sdk/dist/xeoconvert/xeoconvert --pipeline cityjson --cityjson ./models/${modelId}/cityjson/model.json --stats-report  ./models/${modelId}/cityjson/xeoconvert-stats-report.json --manifest-report ./models/${modelId}/cityjson/xeoconvert-manifest-report.json  --log > ./models/${modelId}/cityjson/xeoconvert-log.txt"
    },
    {
      "id": "las",
      "cmd": "node ../sdk/dist/xeoconvert/xeoconvert --pipeline las --cityjson ./models/${modelId}/las/model.las --stats-report  ./models/${modelId}/las/xeoconvert-stats-report.json --manifest-report ./models/${modelId}/las/xeoconvert-manifest-report.json --log > ./models/${modelId}/las/xeoconvert-log.txt"
    },
    {
      "id": "laz",
      "cmd": "node ../sdk/dist/xeoconvert/xeoconvert --pipeline las --cityjson ./models/${modelId}/las/model.laz --stats-report  ./models/${modelId}/las/xeoconvert-stats-report.json --manifest-report ./models/${modelId}/las/xeoconvert-manifest-report.json --log > ./models/${modelId}/las/xeoconvert-log.txt"
    },
    {
      "id": "dotbim",
      "cmd": "node ../sdk/dist/xeoconvert/xeoconvert --pipeline dotbim --dotbim ./models/${modelId}/dotbim/model.bim --stats-report  ./models/${modelId}/dotbim/xeoconvert-stats-report.json --manifest-report ./models/${modelId}/dotbim/xeoconvert-manifest-report.json --log > ./models/${modelId}/dotbim/xeoconvert-log.txt"
    },
    {
      "id": "gltf",
      "cmd": "node ../sdk/dist/xeoconvert/xeoconvert --pipeline gltf --gltf ./models/${modelId}/gltf/model.glb --stats-report  ./models/${modelId}/gltf/xeoconvert-stats-report.json --manifest-report ./models/${modelId}/gltf/xeoconvert-manifest-report.json  --log > ./models/${modelId}/gltf/xeoconvert-log.txt"
    },
    {
      "id": "gltf2xgf",
      "cmd": "node ../sdk/dist/xeoconvert/xeoconvert.js --pipeline gltf2xgf --gltf ./models/${modelId}/gltf/model.glb --xgf ./models/${modelId}/gltf2xgf/sceneModel.xgf --datamodel ./models/${modelId}/gltf2xgf/dataModel.json --stats-report   ./models/${modelId}/gltf2xgf/xeoconvert-stats-report.json --manifest-report ./models/${modelId}/gltf2xgf/xeoconvert-manifest-report.json --log > ./models/${modelId}/gltf2xgf/xeoconvert-log.txt",
      "dependson": [
        "gltf"
      ]
    },
    {
      "id": "las2xgf",
      "cmd": "node ../sdk/dist/xeoconvert/xeoconvert --pipeline las2xgf --las ./models/${modelId}/laz/model.* --xgf ./models/${modelId}/las2xgf/sceneModel.xgf --datamodel ./models/${modelId}/las2xgf/dataModel.json --stats-report   ./models/${modelId}/las2xgf/xeoconvert-stats-report.json --manifest-report ./models/${modelId}/las2xgf/xeoconvert-manifest-report.json --log > ./models/${modelId}/las2xgf/xeoconvert-log.txt",
      "dependson": [
        "laz"
      ]
    },
    {
      "id": "ifc2gltf",
      "cmd": "node ../sdk/dist/xeoconvert/xeoconvert --pipeline dotbim2xgf --dotbim ./models/${modelId}/dotbim/model.bim --xgf  ./models/${modelId}/dotbim2xgf/sceneModel.xgf --datamodel ./models/${modelId}/dotbim2xgf/dataModel.json --stats-report   ./models/${modelId}/dotbim2xgf/xeoconvert-stats-report.json --manifest-report ./models/${modelId}/dotbim2xgf/xeoconvert-manifest-report.json --log > ./models/${modelId}/dotbim2xgf/xeoconvert-log.txt",
      "dependson": [
        "ifc"
      ]
    },
    {
      "id": "ifc2gltf2xgf",
      "__cmd": "node ../sdk/dist/ifc2gltf2xgf/ifc2gltf2xgf.js -i ./models/${modelId}/ifc2gltf/model.manifest.json -o ./models/${modelId}/ifc2gltf2xgf/model.manifest.json --stats-report  ./models/${modelId}/ifc2gltf2xgf/xeoconvert-stats-report.json --manifest-report ./models/${modelId}/ifc2gltf2xgf/xeoconvert-manifest-report.json --log > ./models/${modelId}/ifc2gltf2xgf/xeoconvert-log.txt",
      "dependson": [
        "ifc2gltf"
      ]
    },
    {
      "id": "ifc2xgf",
      "cmd": "node ../sdk/dist/xeoconvert/xeoconvert --pipeline ifc2xgf --ifc ./models/${modelId}/ifc/model.ifc --xgf ./models/${modelId}/ifc2xgf/sceneModel.xgf --datamodel ./models/${modelId}/ifc2xgf/dataModel.json --stats-report ./models/${modelId}/ifc2xgf/xeoconvert-stats-report.json --manifest-report ./models/${modelId}/ifc2xgf/xeoconvert-manifest-report.json --log > ./models/${modelId}/ifc2xgf/xeoconvert-log.txt",
      "dependson": [
        "ifc"
      ]
    },
    {
      "id": "ifc2json",
      "cmd": "node ../sdk/dist/xeoconvert/xeoconvert --pipeline ifc2json --ifc ./models/${modelId}/ifc/model.ifc --scenemodel ./models/${modelId}/ifc2json/sceneModel.json --datamodel ./models/${modelId}/ifc2json/dataModel.json --stats-report ./models/${modelId}/ifc2json/xeoconvert-stats-report.json --manifest-report ./models/${modelId}/ifc2json/xeoconvert-manifest-report.json --log > ./models/${modelId}/ifc2json/xeoconvert-log.txt",
      "dependson": [
        "ifc"
      ]
    },
    {
      "id": "dotbim2xgf",
      "cmd": "node ../sdk/dist/xeoconvert/xeoconvert --pipeline dotbim2xgf --dotbim ./models/${modelId}/dotbim/model.bim --xgf  ./models/${modelId}/dotbim2xgf/sceneModel.xgf --datamodel ./models/${modelId}/dotbim2xgf/dataModel.json --stats-report   ./models/${modelId}/dotbim2xgf/xeoconvert-stats-report.json --manifest-report ./models/${modelId}/dotbim2xgf/xeoconvert-manifest-report.json --log > ./models/${modelId}/dotbim2xgf/xeoconvert-log.txt",
      "dependson": [
        "dotbim"
      ]
    },
    {
      "id": "dotbim2ifc",
      "cmd": "node ../sdk/dist/xeoconvert/xeoconvert --pipeline dotbim2ifc --dotbim ./models/${modelId}/dotbim/model.bim --ifc  ./models/${modelId}/dotbim2ifc/model.ifc --stats-report   ./models/${modelId}/dotbim2ifc/xeoconvert-stats-report.json --manifest-report ./models/${modelId}/dotbim2ifc/xeoconvert-manifest-report.json --log > ./models/${modelId}/dotbim2ifc/xeoconvert-log.txt",
      "dependson": [
        "dotbim"
      ]
    },
    {
      "id": "dotbim2json",
      "cmd": "node ../sdk/dist/xeoconvert/xeoconvert --pipeline dotbim2json --dotbim ./models/${modelId}/dotbim/model.bim --scenemodel ./models/${modelId}/dotbim2json/sceneModel.json --datamodel ./models/${modelId}/dotbim2json/dataModel.json --stats-report ./models/${modelId}/dotbim2json/xeoconvert-stats-report.json --manifest-report ./models/${modelId}/dotbim2json/xeoconvert-manifest-report.json --log > ./models/${modelId}/dotbim2json/xeoconvert-log.txt",
      "dependson": [
        "dotbim"
      ]
    },
    {
      "id": "dotbim2gltf",
      "cmd": "node ../sdk/dist/xeoconvert/xeoconvert --pipeline dotbim2gltf --dotbim ./models/${modelId}/dotbim/model.bim --gltf ./models/${modelId}/dotbim2gltf/sceneModel.glb --datamodel ./models/${modelId}/dotbim2gltf/dataModel.json --stats-report ./models/${modelId}/dotbim2gltf/xeoconvert-stats-report.json --manifest-report ./models/${modelId}/dotbim2gltf/xeoconvert-manifest-report.json --log > ./models/${modelId}/dotbim2gltf/xeoconvert-log.txt",
      "dependson": [
