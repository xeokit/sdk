{
    "tasks": {
        "sdk-test": {
            "cache": false,
            "persistent": true
        },
        "sdk-dist": {
            "cache": false
        },
        "website-sdk-docs": {
            "cache": false,
            "persistent": true
        },
        "website-build-xeokit-lib": {
            "cache": false,
            "dependsOn": [
                "^sdk-dist"
            ]
        },
        "website-convert-models": {
            "cache": false,
            "dependsOn": [
                "^website-build-xeokit-lib"
            ]
        },
        "website-example-snapshots": {
            "cache": true,
            "dependsOn": [
                "^website-convert-models"
            ]
        },
        "website-build": {
            "cache": false,
            "dependsOn": [
                "^website-example-snapshots",
                "^website-sdk-docs"
            ]
        },
        "website-build-local": {
            "cache": false,
            "dependsOn": [
                "^website-example-snapshots",
                "^website-sdk-docs"
            ]
        }
    }
}
